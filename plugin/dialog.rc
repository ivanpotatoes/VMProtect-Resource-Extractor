#include <windows.h>
#include "resource.h"

IDD_VRE DIALOGEX 0, 0, 338, 222
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "VMProtect Resource Extractor"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Module", -1, 10, 7, 318, 42
    COMBOBOX IDC_VRE_MODULE, 20, 24, 240, 112, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_VRE_REFRESH, 266, 23, 52, 15
    GROUPBOX "Protected resources", -1, 10, 56, 318, 43
    COMBOBOX IDC_VRE_TABLE, 20, 73, 286, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "?", IDC_VRE_HELP_SCAN, "Static", SS_CENTER | SS_NOTIFY, 308, 75, 10, 11
    GROUPBOX "Output folder", -1, 10, 106, 318, 44
    EDITTEXT IDC_VRE_OUTPUT, 20, 123, 240, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Browse...", IDC_VRE_BROWSE, 266, 123, 52, 15
    CONTROL "?", IDC_VRE_HELP_OUTPUT, "Static", SS_CENTER | SS_NOTIFY, 308, 108, 10, 10
    LTEXT "Load a program, then scan after it has unpacked.", IDC_VRE_STATUS, 10, 159, 318, 26, SS_EDITCONTROL | SS_NOPREFIX
    PUSHBUTTON "About", IDC_VRE_ABOUT, 10, 195, 48, 18
    DEFPUSHBUTTON "Scan", IDC_VRE_SCAN, 138, 195, 56, 18
    PUSHBUTTON "Extract", IDC_VRE_EXTRACT, 200, 195, 62, 18
    PUSHBUTTON "Close", IDCANCEL, 268, 195, 60, 18
END
